mosq:
    docker run --rm -d -p 1883:1883 -v "$(realpath $PWD/..)/mosquitto/config:/mosquitto/config" eclipse-mosquitto

sub ID:
    docker run --rm --net host -it eclipse-mosquitto mosquitto_sub -t "arena/sparknode{{ID}}/cmd" -v

# eg. just server ../Robot_config_JSONS/4_square.json
server *SIM_CONFIG:
    uv run src/main.py {{SIM_CONFIG}}

check-all:
    uv run ruff format
    uv run ruff check --fix
    uv run ty check
    uv run pytest
